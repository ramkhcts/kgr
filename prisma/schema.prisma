generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String   // UserRole: CLIENT | PMO_LEAD | PMO_TEAM | SUPER_ADMIN
  specialization String?  // Specialization: SOLUTIONING | DELIVERY | COMMERCIAL | GENERAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submittedProjects   Project[]         @relation("Submitter")
  assignedProjects    Project[]         @relation("AssignedResource")
  auditLogs           AuditLog[]
  statusChanges       StatusHistory[]
  comments            Comment[]
  uploadedDocuments   Document[]
  resourceAssignments ProjectResource[] @relation("AssignedResources")
  changeRequestsSubmitted ChangeRequest[] @relation("CRSubmitter")
  changeRequestsReviewed  ChangeRequest[] @relation("CRReviewer")
  skills          UserSkill[]
}

model Project {
  id                   String   @id @default(cuid())
  projectName          String
  description          String
  scopeOfWork          String   // ScopeOfWork: SITE_SUPPORT_SERVICES | SERVICE_DESK | REMOTE_COMMAND_CENTER | FIELD_SERVICES
  location             String
  anticipatedStartDate DateTime
  anticipatedEndDate   DateTime
  budgetAvailable      Boolean
  notes                String?
  status               String   @default("SUBMITTED")   // ProjectStatus
  ragStatus            String   @default("GREEN")        // RAGStatus: RED | AMBER | GREEN
  estimatedCost        Float?
  cancelledReason      String?
  infoRequestMessage   String?
  sowNotes             String?
  poNumber             String?
  closureNotes         String?
  region               String   @default("NA")           // Region: NA | EMEA | LATAM | ASPAC
  customFields         String?  // JSON blob for dynamic field values
  priority              String    @default("MEDIUM")
  urgency               String    @default("STANDARD")
  requestingDepartment  String?
  businessOwner         String?
  numberOfFtes          Int?
  coverageModel         String?
  workplaceModel        String?
  incumbentVendor       String?
  complianceNotes       String?
  businessJustification String?
  slaTargetDate  DateTime?
  slaBreached    Boolean   @default(false)
  slaPausedAt    DateTime?
  slaCredit      Float?    @default(0)

  poValue        Float?
  poReceivedDate DateTime?
  poExpiryDate   DateTime?
  invoicedAmount Float?    @default(0)

  // Intake enrichment
  contractType            String?
  estimatedMonthlyTickets Int?
  avgHandleTimeMinutes    Int?
  itsmPlatform            String?
  estimatedAssetCount     Int?
  goLiveDeadline          DateTime?
  budgetRangeMin          Float?
  budgetRangeMax          Float?
  businessOwnerEmail      String?
  requiredLanguages       String?
  dataClassification      String?

  // Commercial
  poCurrency              String?   @default("USD")
  paymentTermsDays        Int?      @default(30)
  actualCostToDate        Float?    @default(0)
  msaReference            String?
  serviceTier             String?   // BASIC | STANDARD | PREMIUM | ENTERPRISE

  // Incumbent / transition
  transitionPeriodWeeks   Int?
  transitionNotes         String?
  incumbentContractExpiry DateTime?
  incumbentCooperative    Boolean?

  // Contacts
  technicalContactName    String?
  technicalContactEmail   String?
  procurementContactName  String?
  procurementContactEmail String?

  // Info request counter
  infoRequestCount        Int       @default(0)

  submittedById      String
  submittedBy        User    @relation("Submitter", fields: [submittedById], references: [id])
  assignedResourceId String?
  assignedResource   User?   @relation("AssignedResource", fields: [assignedResourceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory    StatusHistory[]
  auditLogs        AuditLog[]
  documents        Document[]
  comments         Comment[]
  resources        ProjectResource[]
  invoiceMilestones InvoiceMilestone[]
  changeRequests   ChangeRequest[]
  slaBreaches      SLABreach[]
}

model ProjectResource {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation("AssignedResources", fields: [userId], references: [id])
  roleName  String
  dailyRate Float
  currency  String    @default("USD")
  startDate DateTime?
  endDate   DateTime?
  isLead    Boolean   @default(false)
  notes     String?
  bgCheckStatus         String?   // PENDING | IN_PROGRESS | CLEARED | FAILED
  shiftPattern          String?   // DAY | EVENING | NIGHT | WEEKEND | ROTATING
  rampUpEndDate         DateTime?
  rampDownStartDate     DateTime?
  externalResourceName  String?
  externalResourceEmail String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model InvoiceMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  dueDate     DateTime?
  invoicedAt  DateTime?
  paidAt      DateTime?
  status      String    @default("PENDING")
  invoiceNumber String?
  currency      String?  @default("USD")
  taxRate       Float?   @default(0)
  taxAmount     Float?   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  type         String   // DocumentType: SOW_DRAFT | SIGNED_SOW | STAFFING_ORDER | PO | COMMERCIAL | OTHER
  mimeType     String   @default("application/pdf")
  size         Int
  content      Bytes
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  version      Int      @default(1)
  supersededAt DateTime?
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatusHistory {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedAt   DateTime @default(now())
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  notes       String?
}

model RateCard {
  id            String   @id @default(cuid())
  serviceType   String   // ScopeOfWork
  roleName      String
  hourlyRate    Float
  dailyRate     Float
  currency      String   @default("USD")
  region        String   @default("NA")  // Region: NA | EMEA | LATAM | ASPAC
  effectiveDate DateTime @default(now())
  isActive      Boolean  @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model SLAPolicy {
  id          String   @id @default(cuid())
  status      String   @unique
  targetDays  Int
  warningDays Int
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model FormField {
  id          String   @id @default(cuid())
  fieldKey    String   @unique
  label       String
  type        String   // text | number | dropdown | textarea | checkbox
  required    Boolean  @default(false)
  options     String?  // JSON: ["Option A","Option B"] for dropdown type
  placeholder String?
  hint        String?
  section     String   @default("details")
  sortOrder   Int      @default(100)
  isActive    Boolean  @default(true)
  isCore      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChangeRequest {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedById  String
  submittedBy    User     @relation("CRSubmitter", fields: [submittedById], references: [id])
  reviewedById   String?
  reviewedBy     User?    @relation("CRReviewer", fields: [reviewedById], references: [id])
  title          String
  description    String
  impactScope    String?
  impactCost     Float?
  impactSchedule String?
  status         String   @default("PENDING")
  responseNotes  String?
  submittedAt    DateTime @default(now())
  reviewedAt     DateTime?
  updatedAt      DateTime @updatedAt
}

model UserSkill {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName        String
  certificationBody String?
  expiryDate       DateTime?
  proficiencyLevel String?  // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  createdAt        DateTime @default(now())
}

model SLABreach {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String
  breachedAt   DateTime @default(now())
  daysOverdue  Float
  creditPct    Float    @default(0)
  creditAmount Float    @default(0)
}
